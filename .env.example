# Copy to .env and point at your own data. Only SPOTIFY_CLEAN_DIR is required;
# everything else degrades gracefully when absent.
SPOTIFY_CLEAN_DIR=/path/to/your/spotify-history/clean
PLAYLIST_JSON=
LIBRARY_JSON=
PITCHFORK_SCRAPED_DB=
PITCHFORK_KAGGLE_DB=
FANTANO_DB=
VOL1_URIS=
LASTFM_API_KEY=
LISTENBRAINZ_TOKEN=
# Your ListenBrainz username. The Ledger grades last week's picks against
# this account's listens; without it the ledger is skipped, not faked.
LISTENBRAINZ_USER=
# Optional: a Listening Record Vol. 1 write-up to seed the served ledger
# from. Leave empty to start with nothing served.
PLAYLIST_MD=
ANTHROPIC_API_KEY=
